  "definitions": [
    {
      "id": "HawkingMass",
      "text": "\\(m=\\frac r2(1+4\\Omega^{-2}r_u r_v)\\)，其中下标表示相应坐标偏导。",
      "origin": "user",
      "citations": [
        {
          "source_id": "S-71f3e610ecd18445667d38f4",
